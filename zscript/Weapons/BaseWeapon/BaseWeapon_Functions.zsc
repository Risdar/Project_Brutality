	{
		return (owner.CountInv("PB_PowerStrength") >= 1);
	}

	// [Beef] you know we should really move from using hard coded states lol
	// Used for interrupting the hand animation when kicking with melee attacks
	action bool PB_MeleeKickInterruptCheck()
	{
		static const StateLabel meleeKickStates[] = {
			"LeftJab", "LeftHook", "LeftUpperCut", "LeftBackHand",
			"RightJab", "RightHook", "RightUpperCut", "RightBackHand"
		};

		for (int i = 0; i < meleeKickStates.Size(); i++)
		{
			if (InStateSequence(PB_GetWeaponState(PSP_WEAPON), invoker.ResolveState(meleeKickStates[i])))
				return true;
		}
		return false;
	}
	
	action bool PB_MeleeAttackKickCheck() 
	{
		static const StateLabel meleeAttackStates[] = {
			"LeftJab", "LeftHook", "LeftUpperCut", "LeftBackHand",
			"RightJab", "RightHook", "RightUpperCut", "RightBackHand",
			"SideKickRight", "SideKickLeft","HookKickLeft","ThrustKick",
			"AirKickCombo","HookKickRight"
		};

		for (int i = 0; i < meleeAttackStates.Size(); i++)
		{
			if (InStateSequence(PB_GetWeaponState(PSP_WEAPON), invoker.ResolveState(meleeAttackStates[i])))
				return false;
		}
		return true;
	}

	action bool PB_WeaponIsInReadyState()
	{
		static const StateLabel readyStates[] = {
			"Ready", "ReallyReady", "ReadyToFireDrum", "ReallyReady2Loop",
			"ReadyToFire", "Ready2", "Ready5", "Ready4",
			"ReallyReady3", "ActuallyReady3", "Ready3",
			"JavelinReady3",      // Nailgun Javelin mode
			"ReadyToFire2",       // Hell Rifle Green mode
			"ReadyMissile",       // LMG Micro Missile mode
			"ReadyToFire_Red", "WeaponRespect",
			"FlashKicking", "FlashAirKicking",
			"FlashSlideKickingStop", "FlashSlideKickingMissileStop", "FlashSlideKickingStopDrumMag",
			"FlashKickingDual", "FlashAirKickingDual", "FlashSlideKickingStopDual",
			"FlashBarrelKicking", "FlashBarrelAirKicking", "FlashBarrelSlideKickingStop"
		};
	
		for (int i = 0; i < readyStates.Size(); i++)
		{
			if (InStateSequence(PB_GetWeaponState(PSP_WEAPON), invoker.ResolveState(readyStates[i])))
				return true;
		}

		// Dual-wield only counts as ready once both hands are in idle state
		// and the weapon state itself is a dual-wield ready state.
		bool leftIdle  = InStateSequence(PB_GetWeaponState(PSP_LEFTGUN),  invoker.ResolveState("IdleLeft_Overlay"));
		bool rightIdle = InStateSequence(PB_GetWeaponState(PSP_RIGHTGUN), invoker.ResolveState("IdleRight_Overlay"));
		bool dualReady = InStateSequence(PB_GetWeaponState(PSP_WEAPON),   invoker.ResolveState("ReadyToFireDualWield")) 
					  || InStateSequence(PB_GetWeaponState(PSP_WEAPON),   invoker.ResolveState("ReadyDualWield"));

		return leftIdle && rightIdle && dualReady;
	}

	action bool PB_WeaponIsInSlidingState()
	{
		static const StateLabel slideStates[] = {
			"FlashSlideKicking", "FlashSlideKickingDW", "FlashSlideKicking2", "FlashSlideKickingDrumMag",
			"FlashSlideKickingMissile", "DualFlashSlideKicking", "FlashSlideKickingDual", "FlashSlideKickingAkimbo",
			"FlashSlideKickingDualWield", "DualWieldFlashSlideKicking"
		};

		for (int i = 0; i < slideStates.Size(); i++)
		{
			if (InStateSequence(PB_GetWeaponState(PSP_WEAPON), invoker.ResolveState(slideStates[i])))
				return true;
		}
		return false;
	}
	
//////////////////////////// DUAL WIELD FUNCTIONS ////////////////////////////////////////////////////////////////////////////////////
	// Yes I am that lazy
	action void PB_ClearDualWield()
	{
		A_ClearOverlays(PSP_LEFTGUN, PSP_RIGHTGUN);
	}

	action void PB_SetupDualWield(
		int crosshair, 
		statelabel left  = "IdleLeft_Overlay", 
		statelabel right = "IdleRight_Overlay",
		int leftoverlay  = PSP_LEFTGUN,
		int rightoverlay = PSP_RIGHTGUN)
	{
		PB_SetRoll(0);
        PB_HandleCrosshair(crosshair);
        A_SetInventory("PB_LockScreenTilt",0);
        A_SetFiringRightWeapon(False);
        A_SetFiringLeftWeapon(False);
        A_TakeInventory("DualFiring",1);
		if(invoker.ammoleft.amount < invoker.ammo2.amount) // I have no idea if this can cause issues later or not lol
			A_GiveInventory("DualFiring",1);
        A_Overlay(leftoverlay, left, false);
        A_Overlay(rightoverlay, right, false);
	}

	action state A_DoPBDualAction(int reservenum = 1)
	{
		if(CountInv(invoker.ammotype1) >= reservenum)
		{
			A_SetInventory("DualFireReload",0);
			if(PB_GetChamberEmpty())
				A_GiveInventory("DualFireReload",1);
			if(PB_GetChamberEmpty(true))
				A_GiveInventory("DualFireReload",1);
		}
			
		if(!PB_CanDualWield())
			return resolvestate("StopDualWield");
		
		return A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOFIRE);
	}
	
	action state A_DoPBLeftAction(int minammo = 1)
	{
		int firemodecvar = Cvar.GetCvar("SingleDualFire",player).GetInt();
		if(CountInv(invoker.ammotypeleft) >= minammo && !PB_GetChamberEmpty(true))
		{
			switch(firemodecvar)
			{
				case 0:
					if(PressingFire() && !A_IsFiringRightWeapon() && CountInv("DualFiring") == 0)
						return resolvestate("FireLeft_Overlay");
					break;
				case 1:
					if(PressingFire() && !A_IsFiringLeftWeapon())
						return resolvestate("FireLeft_Overlay");
					break;
				case 2:
					if(PressingAltFire() && !A_IsFiringLeftWeapon())
						return resolvestate("FireLeft_Overlay");
					break;
			}
		}
		else
		{
			switch(firemodecvar)
			{
				case 0:
					if(JustPressed(BT_ATTACK) && !A_IsFiringRightWeapon() && CountInv("DualFiring") == 0)
						A_StartSound("weapons/empty", 10,CHANF_OVERLAP);
					break;
				case 1:
					if(JustPressed(BT_ATTACK) && !A_IsFiringLeftWeapon())
						A_StartSound("weapons/empty", 10,CHANF_OVERLAP);
					break;
				case 2:
					if(JustPressed(BT_ALTATTACK) && !A_IsFiringLeftWeapon())
						A_StartSound("weapons/empty", 10,CHANF_OVERLAP);
					break;
			}
			if(!PB_GetChamberEmpty() && CountInv(invoker.ammotype2) >= minammo)
				A_SetInventory("DualFiring",1);
		}
		return resolvestate(null);
	}
		
	action state A_DoPBRightAction(int minammo = 1)
	{
		int firemodecvar = Cvar.GetCvar("SingleDualFire",player).GetInt();
		if(CountInv(invoker.ammotype2) >= minammo && !PB_GetChamberEmpty())
		{
			switch(firemodecvar)
			{
				case 0:
					if(PressingFire() && !A_IsFiringLeftWeapon() && CountInv("DualFiring") == 1)
						return resolvestate("FireRight_Overlay");
					break;
				case 1:
					if(PressingAltFire() && !A_IsFiringRightWeapon())
						return resolvestate("FireRight_Overlay");
					break;
				case 2:
					if(PressingFire() && !A_IsFiringRightWeapon())
						return resolvestate("FireRight_Overlay");
					break;
			}
		}
		else
		{
			switch(firemodecvar)
			{
				case 0:
					if(JustPressed(BT_ATTACK) && !A_IsFiringLeftWeapon() && CountInv("DualFiring") == 1)
						A_StartSound("weapons/empty", 10,CHANF_OVERLAP);
					break;
				case 1:
					if(JustPressed(BT_ALTATTACK) && !A_IsFiringRightWeapon())
						A_StartSound("weapons/empty", 10,CHANF_OVERLAP);
					break;
				case 2:
					if(JustPressed(BT_ATTACK) && !A_IsFiringRightWeapon())
						A_StartSound("weapons/empty", 10,CHANF_OVERLAP);
					break;
			}
			if(!PB_GetChamberEmpty(true) && CountInv(invoker.ammotypeleft) >= minammo)
				A_SetInventory("DualFiring",0);
		}
		return resolvestate(null);
	}

