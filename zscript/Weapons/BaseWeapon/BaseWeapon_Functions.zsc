extend class PB_WeaponBase
{
//////////////////////////// OVERRIDES ////////////////////////////////////////////////////////////////////////////////////
	// Handles Gun Braced
	override void Tick()
	{
		Super.Tick();
		
		let plr = PlayerPawnBase(Owner);
		if (!plr || !plr.Player)
		{
			GunBraced = false;
			return;
		}
		
		if (plr.Player.ReadyWeapon != self)
		{
			GunBraced = false;
			return;
		}
		
		if (CountInv("ResetZoom") >= 1) {
			A_TakeInventory("ResetZoom", 1);
			A_ZoomFactor(1.0, ZOOM_INSTANT);
		}
		
		FLineTraceData dt1, dt2, dt3, dt4, dt5, dt6;
		plr.LineTrace(plr.Angle, plr.Radius * 3, plr.Pitch, TRF_NOSKY | TRF_THRUACTORS, plr.Height * 0.95, offsetside: -plr.Radius / 2, data: dt1);
		plr.LineTrace(plr.Angle, plr.Radius * 3, plr.Pitch, TRF_NOSKY | TRF_THRUACTORS, plr.Height * 0.95 * 0.75, data: dt2);
		plr.LineTrace(plr.Angle, plr.Radius * 3, plr.Pitch, TRF_NOSKY | TRF_THRUACTORS, plr.Height * 0.95, offsetside: plr.Radius / 2, data: dt3);
		
		plr.LineTrace(plr.Angle + 90, plr.Radius * 3, plr.Pitch, TRF_NOSKY | TRF_THRUACTORS, plr.Height * 0.95, data: dt4);
		plr.LineTrace(plr.Angle + 180, plr.Radius * 3, plr.Pitch, TRF_NOSKY | TRF_THRUACTORS, plr.Height * 0.95 * 0.75, data: dt5);
		plr.LineTrace(plr.Angle - 90, plr.Radius * 3, plr.Pitch, TRF_NOSKY | TRF_THRUACTORS, plr.Height * 0.95, data: dt6);
		
		bool geometryBrace = dt1.HitType == FLineTraceData.TRACE_HitWall || dt2.HitType == FLineTraceData.TRACE_HitWall || dt3.HitType == FLineTraceData.TRACE_HitWall || dt4.HitType == FLineTraceData.TRACE_HitWall || dt5.HitType == FLineTraceData.TRACE_HitWall || dt6.HitType == FLineTraceData.TRACE_HitWall;
		
		if (!bMELEEWEAPON && (plr.Player.crouchfactor == 0.5 || geometryBrace) && plr.Vel.Length() < 6)
		{
			BraceTicker++;
			if (BraceTicker == 10)
			{
				GunBraced = true;
				plr.A_SetPitch(plr.Pitch - 0.2);
				Owner.A_StartSound("Weapon/Bracing", 19, 0, 0.30);
			}
			if (BraceTicker == 11)
			{
				plr.A_SetPitch(plr.Pitch + 0.2);
			}
            if(BraceTicker == 20)
            {
                if(!PB_HelpNotificationsHandler.CheckTipEvent(PB_BRACE_TIP, CVar.GetCvar("pb_helpflags", plr.Player)))
                {
                    Array<String> pbTipsBuf;
                    pbTipsBuf.Push("$PB_BRACE_TIP_1");
                    pbTipsBuf.Push("$PB_BRACE_TIP_2");
                    pbTipsBuf.Push("$PB_BRACE_TIP_3");
                    PB_HelpNotificationsHandler.PB_SendTipArray(pbTipsBuf, "pb_helpflags", PB_BRACE_TIP);
                }
            }
		}
		else
		{
			GunBraced = false;
		}

		if (!GunBraced && BraceTicker > 13)
		{
			BraceTicker = 0;
		}
	}

	//[Pop]weapons should ALWAYS bob, fucking fight me
	override void DoEffect()
	{
		super.DoEffect();

		// let pbweap = PB_WeaponBase(owner.player.ReadyWeapon);
		// if(!pbweap) return;

		if(PB_PixelRenderingFix)
			WeaponScaleX = 1.2; //counter act 20% stretch (THE INTENDED PB VISUALS)
		else
			WeaponScaleX = 1.0; //garbo bullshit 4:3 forced rendering, will need to see about enabling this automatically if on 4:3 resolution

		if(owner.FindInventory("HasBarrel")) {
			owner.SetInventory("HasBarrel",0);
			owner.SetInventory("GrabbedBarrel",1);
			owner.player.SetPSprite(PSP_WEAPON,resolvestate("ReadyBarrel"));
		}
		if(owner.FindInventory("HasFlameBarrel")) {
			owner.SetInventory("HasFlameBarrel",0);
			owner.SetInventory("GrabbedFlameBarrel",1);
			owner.player.SetPSprite(PSP_WEAPON,resolvestate("ReadyFlameBarrel"));
		}
		if(owner.FindInventory("HasIceBarrel")) {
			owner.SetInventory("HasIceBarrel",0);
			owner.SetInventory("GrabbedIceBarrel",1);
			owner.player.SetPSprite(PSP_WEAPON,resolvestate("ReadyIceBarrel"));
		}
		
		if((overheat > 0 || leftOverheat > 0) 
			&& overheatCoolingRate > 0 
			&& owner.player.ReadyWeapon != self 
			&& level.time % overheatCoolingRate == 0
		) 
		{
			overheat 	 = clamp(overheat - 5, 0, maxOverheat);
			leftOverheat = clamp(leftOverheat - 5, 0, maxOverheat);
		}

		if(owner.FindInventory("ToggleEquipment")) 
			EQ_SwitchEquipment();
	}

