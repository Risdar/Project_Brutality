	override state GetAtkState(bool hold)
	{
		if(owner.findinventory("GrabbedBarrel"))
			return resolvestate("ThrowBarrel");
		if(owner.findinventory("GrabbedFlameBarrel"))
			return resolvestate("ThrowFlameBarrel");
		if(owner.findinventory("GrabbedIceBarrel"))
			return resolvestate("ThrowIceBarrel");
		return super.GetAtkState(hold);
	}
	
	override state GetAltAtkState(bool hold)
	{
		if(owner.findinventory("GrabbedBarrel"))
			return resolvestate("PlaceBarrel");
		if(owner.findinventory("GrabbedFlameBarrel"))
			return resolvestate("PlaceFlameBarrel");
		if(owner.findinventory("GrabbedIceBarrel"))
			return resolvestate("PlaceIceBarrel");
		return super.GetAltAtkState(hold);
	}
	
	override state GetDownState()
	{
		if(owner.findinventory("GrabbedBarrel"))
			return resolvestate("PlaceBarrel");
		if(owner.findinventory("GrabbedFlameBarrel"))
			return resolvestate("PlaceFlameBarrel");
		if(owner.findinventory("GrabbedIceBarrel"))
			return resolvestate("PlaceIceBarrel");
		return super.GetDownState();
	}

//////////////////////////// READY FUNCTIONS ////////////////////////////////////////////////////////////////////////////////////
	// [Beef] I think this needs to be reworked lol
	action state A_DoPBWeaponAction(int weapflags = WRF_ALLOWRELOAD, int pbFlags = 0, bool noReload = false)
	{
		bool grabbedbarrel = IsHoldingBarrel();
		bool initialWRF_ALLOWRELOAD = false;

		if (weapflags & WRF_ALLOWRELOAD) 
			initialWRF_ALLOWRELOAD = true;

		weapFlags &= ~(WRF_ALLOWRELOAD);

		if(invoker is "PB_Fists" && !grabbedbarrel)
			weapFlags |= WRF_ALLOWRELOAD;

		if(pbFlags & PB_FORCERELOAD)
			weapFlags |= WRF_ALLOWRELOAD;

		bool dualWieldCheck = A_CheckAkimbo();
		bool canLoadAmmoLeft = invoker.AmmoTypeLeft && countinv(invoker.ammotype1) > 0 && (countInv(invoker.AmmoTypeLeft) < GetAmmoCapacity(invoker.AmmoTypeLeft) || PB_GetMagUnloaded(true));
		bool canLoadAmmo = invoker.ammotype2 && countinv(invoker.ammotype1) > 0 && (countinv(invoker.ammotype2) < GetAmmoCapacity(invoker.ammotype2) || PB_GetMagUnloaded());
		bool dualReloadCheck = dualWieldCheck && (canLoadAmmoLeft||canLoadAmmo||PB_GetChamberEmpty(true)||PB_GetChamberEmpty(true));
		bool ReloadCheck = !noReload && initialWRF_ALLOWRELOAD && (canLoadAmmo || dualReloadCheck || PB_GetChamberEmpty());

		if( !(invoker is "PB_Unmaker") && ReloadCheck )
			weapFlags |= WRF_ALLOWRELOAD;

		static const string PBWeapEmptyToken[] = 
		{
			"PB_PistolWasEmpty","DMRWasEmpty","UACSMGWasEmpty"
		};
		
		static const string PBWeapUnloadedToken[] =
		{
			"HasUnloaded","PulseCannonHasUnloaded", "HasUnloadedRG"
		};

		static const string PBWeapUnloadableClasses [] =
		{
			"PB_Weapon","PulseCannon"
		};

		static const statelabel PBWeapStatelabels[] =
		{
			"Steady", "QuickPunch", //"LedgeClimb",
			"DoKick", "Taunt", "Salute", "Salute",
			"UseEquipment", "SwitchEquipment", "DualWieldBaby",
			"NoDualWield", "WeaponSpecial", "ReadyBarrel", "ReadyIceBarrel",
			"ReadyFlameBarrel", "ThrowBarrel", "ThrowIceBarrel", 
			"ThrowFlameBarrel", "IdleBarrel", "IdleIceBarrel", 
			"IdleFlameBarrel"
		};

		if (PB_executingEnemy())
			return ResolveState("Steady");
		
		if((PressingFire() || PressingAltfire() && CVar.GetCVar("SingleDualFire", player).GetInt() != 0) && !(A_IsFiringLeftWeapon() || A_IsFiringRightWeapon()))
		{
			if(CountInv("DualFireReload") >= 2)
			{
				A_TakeInventory("DualFireReload",2);
				return ResolveState("Reload");
			}
		}
		
		if (CountInv("GoWeaponSpecialAbility")>=1 && !pbFlags & PB_NOWEAPONSPECIAL)
		{
			if (ResolveState("DualWieldBaby")) 
				return ResolveState("DualWieldBaby");
			else if (ResolveState("NoDualWield")) 
				return ResolveState("NoDualWield");
			else 
				return ResolveState("WeaponSpecial");
		}

		if (CountInv("HasBarrel")>=1) 
			return ResolveState("ReadyBarrel");
		
		if (CountInv("HasFlameBarrel")>=1) 
			return ResolveState("ReadyFlameBarrel");
		
		if (CountInv("HasIceBarrel")>=1) 
			return ResolveState("ReadyIceBarrel");
		
		if (CountInv("Unloading")>=1 && !pbFlags & PB_NOUNLOAD && ResolveState("Unload") && ((!PB_GetMagUnloaded() || !PB_GetChamberEmpty()) || (A_CheckAkimbo() && (!PB_GetMagUnloaded(true) || !PB_GetChamberEmpty(true)))))
		{
			A_SetInventory("Unloading",0);
			PB_SetZoom(false);
			A_SetCrosshair(-1);
			PB_ClearDualWield();
			A_SetInventory("DualFireReload",0);
			PB_SetReloading(true);
			return ResolveState("Unload");
		}
		else 
			A_SetInventory("Unloading",0);

		if (PB_GetMagUnloaded() && !A_CheckAkimbo() && invoker.ResolveState("GunEmpty") && !InStateSequence(player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("GunEmpty")))
			return ResolveState("GunEmpty");

		if (ResolveState("LoadChamber"))
		{
			for (int i = 0; i < PBWeapEmptyToken.Size(); ++i)
			{
				if (CountInv(PBWeapEmptyToken[i]) >= 1)
					return ResolveState("LoadChamber");
			}
		}
		
		if (!noReload)
			noReload = ((PressingFire() || JustPressed(BT_ATTACK)) || !PB_GetZoom() && (ResolveState("AltFire") && (PressingAltFire() || JustPressed(BT_ALTATTACK))));
		
		if (noReload) 
		{
			int newflags = WRF_NOSWITCH;
			if (weapflags & WRF_NOBOB) { newflags = newflags | WRF_NOBOB; }
			if (weapflags & WRF_NOFIRE) { newflags = newflags | WRF_NOFIRE; }
			if (weapflags & WRF_NOPRIMARY) { newflags = newflags | WRF_NOPRIMARY; }
			if (weapflags & WRF_NOSECONDARY) { newflags = newflags | WRF_NOSECONDARY; }
			if (weapflags & WRF_ALLOWUSER1) { newflags = newflags | WRF_ALLOWUSER1; }
			if (weapflags & WRF_ALLOWUSER2) { newflags = newflags | WRF_ALLOWUSER2; }
			if (weapflags & WRF_ALLOWUSER3) { newflags = newflags | WRF_ALLOWUSER3; }
			if (weapflags & WRF_ALLOWUSER4) { newflags = newflags | WRF_ALLOWUSER4; }
			if (weapflags & WRF_DISABLESWITCH) { newflags = newflags | WRF_DISABLESWITCH; }
			if (weapflags & WRF_ALLOWZOOM) { newflags = newflags | WRF_ALLOWZOOM; }
			if (PB_usingKick()) { newflags = newflags | WRF_NOFIRE; }
			A_WeaponReady(newflags);
		}

		else 
		{
			if (PB_usingKick()) 
			{
				if (CountInv("IsSlideKicking") >= 1)
					A_WeaponReady(weapflags | WRF_NOFIRE | WRF_NOSWITCH);
				else
					A_WeaponReady(weapflags | WRF_NOSWITCH);
			} 
			else
				A_WeaponReady(weapflags);
		}
		return null;
	}

	// Function for weapons that have both dual wield and ads, just enable the ads if its called in ready2
	action state PB_ReadyFire(
		statelabel fire     = "Fire",
		statelabel firezoom = "Fire2",
		statelabel zoomout  = "Zoomout",
		bool useMag         = true)
	{
		int ammoToCheck = useMag ? invoker.ammo2.amount : invoker.ammo1.amount;
		bool ads = PB_GetZoom();

		if(ads && PB_GetAimMode())
		{
			if(!PressingAltfire() || JustReleased(BT_ALTATTACK))
				return ResolveState(zoomout);
			if(PressingFire() && PressingAltfire() && ammoToCheck > invoker.ReserveToMagAmmoFactor)
				return ResolveState(firezoom);
			return A_DoPBWeaponAction(WRF_ALLOWRELOAD | WRF_NOSECONDARY);
		}

		if(PressingFire() && PressingAltfire() && ammoToCheck > invoker.ReserveToMagAmmoFactor)
			return ResolveState(ads ? firezoom : fire);
		if(PressingFire() && ammoToCheck > invoker.ReserveToMagAmmoFactor)
			return ResolveState(ads ? firezoom : fire);

		return A_DoPBWeaponAction(WRF_ALLOWRELOAD);
	}

	//raises the weapon, and plays a raise sound if any
	//also this avoids needing to go to SelectFirstPersonLegs state after the select state
	//so it can go select -> selectcontinue -> selectanimation
	action void PB_WeaponRaise(string upSnd = "")
	{
		A_weaponoffset(0,32);
		if(upSnd)
			A_startsound(upSnd,32);	//play the select sound if defined
		
		A_setroll(0);
		invoker.curBlood = (0,0,0);
		
		//this was in the SelectFirstPersonLegs state
		A_StopSound(1);
		A_StopSound(CHAN_VOICE);
		A_StopSound(5);
		A_StopSound(6);
		A_StopSound(7);
		A_StopSOund(CHAN_AUTO);
		
		A_SetInventory("Spin",0);
		A_SetInventory("CantWeaponSpecial",0);		//Fixes bug with Weapon Special Key no longer working when changing SGL grenade type or RL missile mode
		A_SetInventory("MG42Selected",0); 			//Take this token on every weapon that's not the MG42.
		A_SetInventory("Grabbing_A_Ledge", 0);		//Fixed bug where movement is locked when vaulting after entering a level
		A_SetInventory("RandomHeadExploder",0);
		A_SetInventory("DualFireReload",0);
		A_SetInventory("Kicking",0);
		PB_SetZoom(false);
		
		A_ClearOverlays(-999, -999);
		A_Overlay(PSP_MELEEEQHANDLER, "Melee_Equipment_Handler_Overlay");
		A_Overlay(PSP_KICKHANDLER, "KickHandler_Overlay");
		invoker.WeaponScaleX = 1.0;
		A_Overlay(PSP_FIRSTPERSONLEGS, "FirstPersonLegsStand");
		invoker.WeaponScaleX = PB_PixelRenderingFix ? 1.2 : 1.0;
		
		PB_SetUsingKick(false);
		PB_SetUsingMelee(false);
		PB_SetUsingEquipment(false);
		PB_SetExecutingEnemy(false);
		PB_SetReloading(false);
		PB_DoWeaponHelpText();
	}

	action void PB_DoWeaponHelpText()
	{
		let plr = self.player;
		name wp = invoker.getClassName();

		switch(wp)
		{
			case 'PB_Flamethrower':
				if(!PB_HelpNotificationsHandler.CheckTipEvent(PB_FLAMETHROWER_TIP, CVar.GetCvar("pb_helpflags", plr))) 
				{
					Array<String> pbTipsBuf;
					pbTipsBuf.Push("$PB_FLAMETHROWER_TIP");
					PB_HelpNotificationsHandler.PB_SendTipArray(pbTipsBuf, "pb_helpflags",PB_FLAMETHROWER_TIP);
				}
				if(!PB_HelpNotificationsHandler.CheckTipEvent(PB_BARREL_TIP1, CVar.GetCvar("pb_helpflags", plr))) 
				{
					Array<String> pbTipsBuf;
					pbTipsBuf.Push("$PB_BARREL_TIP_1");
					PB_HelpNotificationsHandler.PB_SendTipArray(pbTipsBuf, "pb_helpflags", PB_BARREL_TIP1);
				}
				break;

			case 'PB_Carbine':
				if(!PB_HelpNotificationsHandler.CheckTipEvent(PB_CARBINE_TIP, CVar.GetCvar("pb_helpflags", plr))) 
				{
					Array<String> pbTipsBuf;
					pbTipsBuf.Push("$PB_CARBINE_TIP");
					PB_HelpNotificationsHandler.PB_SendTipArray(pbTipsBuf, "pb_helpflags", PB_CARBINE_TIP);
				}
				break;

			case 'PB_MG42':
				if(!PB_HelpNotificationsHandler.CheckTipEvent(PB_MG42_TIP, CVar.GetCvar("pb_helpflags", plr))) 
				{
					Array<String> pbTipsBuf;
					pbTipsBuf.Push("$PB_MG42_TIP");
					PB_HelpNotificationsHandler.PB_SendTipArray(pbTipsBuf, "pb_helpflags", PB_MG42_TIP);
				}
				break;

			case 'PB_M2Plasma':
				if(!PB_HelpNotificationsHandler.CheckTipEvent(PB_BARREL_TIP3, CVar.GetCvar("pb_helpflags", plr))) 
				{
					Array<String> pbTipsBuf;
					pbTipsBuf.Push("$PB_BARREL_TIP_3");
					PB_HelpNotificationsHandler.PB_SendTipArray(pbTipsBuf, "pb_helpflags",PB_BARREL_TIP3);
				}
				break;

			case 'PB_CryoRifle':
				if(!PB_HelpNotificationsHandler.CheckTipEvent(PB_BARREL_TIP2, CVar.GetCvar("pb_helpflags", plr))) 
				{
					Array<String> pbTipsBuf;
					pbTipsBuf.Push("$PB_BARREL_TIP_2");
					PB_HelpNotificationsHandler.PB_SendTipArray(pbTipsBuf, "pb_helpflags",PB_BARREL_TIP2);
				}
				break;

			case 'PB_BFG9000':
				if(!PB_HelpNotificationsHandler.CheckTipEvent(PB_BFG_TIP, CVar.GetCvar("pb_helpflags", plr))) 
				{
					Array<String> pbTipsBuf;
					pbTipsBuf.Push(string.format(StringTable.Localize("$PB_BFG_TIP"), PB_HelpNotificationsHandler.PB_FormatKeybinds("+reload")));
					PB_HelpNotificationsHandler.PB_SendTipArray(pbTipsBuf, "pb_helpflags", PB_BFG_TIP);
				}
				break;

			case 'PB_Railgun':
				if(!PB_HelpNotificationsHandler.CheckTipEvent(PB_RAILGUN_TIP, CVar.GetCvar("pb_helpflags", plr))) 
				{
					Array<String> pbTipsBuf;
					pbTipsBuf.Push(string.format(StringTable.Localize("$PB_RAILGUN_TIP"), PB_HelpNotificationsHandler.PB_FormatKeybinds("+pb_specialwheel")));
					PB_HelpNotificationsHandler.PB_SendTipArray(pbTipsBuf, "pb_helpflags", PB_RAILGUN_TIP);
				}
				break;

			case 'PB_Unmaker':
				if(!PB_HelpNotificationsHandler.CheckTipEvent(PB_UNMAKER_TIP, CVar.GetCvar("pb_helpflags", players[consoleplayer])))
				{
					Array<String> pbTipsBuf;
					pbTipsBuf.Push("$PB_UNMAKER_TIP_1");
					pbTipsBuf.Push(string.format(StringTable.Localize("$PB_UNMAKER_TIP_2"), PB_HelpNotificationsHandler.PB_FormatKeybinds("+pb_specialwheel")));
					pbTipsBuf.Push("$PB_UNMAKER_TIP_3");
					PB_HelpNotificationsHandler.PB_SendTipArray(pbTipsBuf, "pb_helpflags",PB_UNMAKER_TIP);
				}
				break;
		}

	}

	action state PB_RespectIfNeeded()
	{
		//A_Log("PB_RespectIfNeeded");
		Actor own = invoker.owner;
		bool shouldHelmet = !Cvar.GetCvar("PB_NoHelmetAnimation",player).GetBool() && !own.FindInventory("IntroductionSequence"); //ACS_NamedExecuteWithResult("ToggleHelmetAnimation",0,0,0) == 0
		bool shouldRespect = !invoker.respected || level.time == 0;
		if (shouldHelmet)
		{
			own.GiveInventory("CantDoAction",1);
			//Console.printf("Setting State: HelmetAnimation");
			return invoker.resolveState("HelmetAnimation");
		}			
		else if (shouldRespect)
		{
			//Console.printf("Setting State: WeaponRespect");
			invoker.respected = true;
			return invoker.resolveState("WeaponRespect");
		}
		else
		{
			//Console.printf("Setting State: SelectAnimation");
			return invoker.A_Jump(256,"SelectAnimation");
		}
	}

	//Weapon token take away in one function
	action void PB_WeapTokenSwitch(name wepToken) 
	{
		PB_SetUsingMelee(false); //force to false so that quick melee doesn't break on some weapons
		PB_SetUsingKick(false); //force to false so that kicking doesn't break on some weapons
		PB_SetUsingEquipment(false);
		PB_SetExecutingEnemy(false);
		SetPlayerProperty(0,0,0); //Force the player to get unstuck
		PB_SetZoom(false);
		A_SetInventory("Unloading",0);
		A_SetInventory("DMRSelected",0);
		A_SetInventory("CarbineSelected",0);
		A_SetInventory("FistsSelected",0);
		A_SetInventory("SawSelected",0);
		A_SetInventory("SledgeSelected",0);
		A_SetInventory("HandgunSelected",0);
		A_SetInventory("DualHandgunSelected",0);
		A_SetInventory("RevolverSelected",0);
		A_SetInventory("DeagleSelected",0);
		A_SetInventory("ShotgunSelected",0);
		A_SetInventory("SSGSelected",0);
		A_SetInventory("ASGSelected",0);
		A_SetInventory("QSGSelected",0);
		A_SetInventory("MinigunSelected",0);
		A_SetInventory("MG42Selected",0);
		A_SetInventory("NewChaingunSelected",0);
		A_SetInventory("RocketLauncherSelected",0);
		A_SetInventory("GrenadeLauncherSelected",0);
		A_SetInventory("SGLSelected",0);
		A_SetInventory("PlasmaGunSelected",0);
		A_SetInventory("M2Selected",0);
		A_SetInventory("CryoRifleSelected",0);
		A_SetInventory("RailGunSelected",0);
		A_SetInventory("BFGSelected",0);
		A_SetInventory("BFGBeamSelected",0);
		A_SetInventory("BHCSelected",0);
		A_SetInventory("RevenantLauncherSelected",0);
		A_SetInventory("UnmakerSelected",0);
		A_SetInventory("FlameCannonSelected",0);
		A_SetInventory("HellRifleSelected",0);
		A_SetInventory("LandMineSelected",0);
		A_SetInventory("UACSMGSelected",0);
		A_SetInventory("MP40Selected",0);
		A_SetInventory("AddonSelected",0);
		A_SetInventory("LostSoulSelected",0);
		A_SetInventory("CantWeaponSpecial",0);
		A_SetInventory("HasIncendiaryWeapon", 0);
		A_SetInventory("HasPlasmaWeapon",0);
		A_SetInventory("HasCutingWeapon",0);
		A_SetInventory("HasFireWeapon",0);
		A_SetInventory("HasAcidWeapon",0);
		A_SetInventory("Grabbing_A_Ledge",0);
		A_SetInventory("CantDoAction",0);
		A_SetInventory("PB_NoEffectInvul",0);
		A_SetInventory("sae_extcam", 0);
		A_SetInventory("sae_deathcam", 0);
		A_SetInventory(wepToken,1);
	}

	action int getReadyFlags(int weapflags, bool noReload)
	{
		static const int PBWeapReadyFlags[] = 
		{
			WRF_NOSWITCH, WRF_NOBOB, WRF_NOFIRE, WRF_NOPRIMARY, WRF_NOSECONDARY, 
			WRF_ALLOWUSER1, WRF_ALLOWUSER2, WRF_ALLOWUSER3, WRF_ALLOWUSER4,
			WRF_DISABLESWITCH, WRF_ALLOWZOOM, WRF_ALLOWRELOAD
		};
		int ammo1Left = -1;
		int ammo2Left = -1;
		if (invoker.ammotype1) ammo1Left = CountInv(invoker.ammotype1); 
		if (invoker.ammotype2) ammo2Left = CountInv(invoker.ammotype2); 
		bool isAmmoEmpty = ammo1Left == 0 && ammo2Left == 0;
		
		int newflags = 0;
		for ( int i = 0; i < PBWeapReadyFlags.size(); i++ )
		{
			int flag = PBWeapReadyFlags[i];
			if((noReload || isAmmoEmpty) && flag == WRF_ALLOWRELOAD) continue;
			if(weapflags & flag) { newflags |= flag; }
		}
		if (isAmmoEmpty) newflags |= WRF_NOPRIMARY;
		if (PB_usingKick()) { newflags |= WRF_NOFIRE | WRF_NOSWITCH; }
		
		return newflags;
	}
		
//////////////////////////// RELOAD FUNCTIONS ////////////////////////////////////////////////////////////////////////////////////
	//put this in the beginning of the reload state
	//	-emptyReload is meant for guns that have different reloads when its empty, if its not the case just pass null (without "")
	//	-fullAlready is the state it jumps if its already full, usually just ready3. for dual weapons, the right weapon should use this to skip its reload and go to the left weapon.
	//	-noAmmo is the state to jump if theres no reserve ammo. this should usually be ready3
	//	-full is the amount considered for the gun to be full
	//	-equal is the equivalence between the ammo reserve and a single bullet/shell/whateverammouses loaded
	//	-dual use this if you want to check the left weapon instead

	//check for ammo in the gun, do necessary functions
	action state PB_CheckReload(statelabel unloadedReload,statelabel emptyReload,statelabel loadChamber,statelabel fullAlready,statelabel noAmmo,int full,int equal = 1,bool dual = false)
	{
		int amount1 = countinv(invoker.ammotype1); //reserve
		int amount2 = dual ? countinv(invoker.ammotypeleft) : countinv(invoker.ammotype2); //to be loaded
		
		if(amount1 < equal) //if theres not reserve ammo enough to reload a single bullet
			return resolvestate(noAmmo);
		
		else
		{
			A_SetInventory("DualFireReload",0);
			A_SetInventory("Zoomed",0);
			A_ZoomFactor(1.0);
			A_SetCrosshair(-1);
			PB_ClearDualWield();
			PB_SetReloading(true);
			
			if(fullAlready && full > 0 && amount2 >= full && !PB_GetChamberEmpty(dual) && !PB_GetMagUnloaded(dual)) //if the weapon is already full
				return resolvestate(fullAlready);
			
			else if(unloadedReload && PB_GetMagUnloaded(dual)) //if the mag was unloaded
				return resolvestate(unloadedReload);
			
			else if(loadChamber && PB_GetChamberEmpty(dual) && !PB_GetMagEmpty(dual) && !PB_GetMagUnloaded(dual)) //if the chamber was empty and the mag has ammo
				return resolvestate(loadChamber);
			
			else if(emptyReload && PB_GetChamberEmpty(dual)) //if the chamber was empty and the mag is empty
				return resolvestate(emptyReload);
		}

		return resolvestate(null);
	}
	
	//put this in the beggining of the fire state to determine if it can fire or needs reloading
	//this replaces the usual:
	//	TNT1 A 0 A_jumpifinventory(ammo,1,1)
	//	goto reload
	// it also lets you specify the specific reload state to jump
	// reloadstate is the state to jump if theres no ammo (default is reload)
	// min is the minimum ammo in the mag before its considered empty, lower than this means it will jump to the specified reloadstate
	// chamber is for weapons that doesnt have a chamber
	// secondary means the weapon uses a magazine, set this to false if the weapon uses the reserve ammo
	action state PB_jumpIfNoAmmo(statelabel reloadstate = "Reload",int min = 1,bool chamber = true,bool secondary = true,string emptysound = "weapons/empty")
	{
		if(PB_GetChamberEmpty() || //look on my works, ye mighty, and despair
		PB_GetMagUnloaded() && !chamber ||
		!secondary && invoker.ammotype1 && countinv(invoker.ammotype1) < min ||
		secondary && invoker.ammotype2 && countinv(invoker.ammotype2) < min) {
			if(emptysound) {
				A_StartSound(emptysound,0);
			}
			return resolvestate(reloadstate);
		}
		return resolvestate(null);
	}

	//A way to perform pretty much take all of the "Insertbullets" states and turn it into a function
	//An example of this action: PB_AmmoIntoMag("DMRAmmo","PB_HighCalMag",30,1) 
	// AmmoPool_Action 			= The name of the Ammo1 (Reserve) class
	// AmmoMag_Action			= The name of the Ammo2 (Magazine) class
	// MagazineMaxFill_Action 	= The full size of Ammo2 (Magazine), basically how many cycles should be done
	// takeReserve 				= How many Ammo1 (Reserve) to take for every cycle
	// giveMag 					= How many Ammo2 (Magazine) to give for every cycle
	action void PB_AmmoIntoMag(String AmmoMag_Action,String AmmoPool_Action,int MagazineMaxFill_Action, int takeReserve = 1, int giveMag = 1)
	{
		for(int i = 0; i < MagazineMaxFill_Action; i++)
		{
			if((CountInv(AmmoMag_Action) >= MagazineMaxFill_Action) || CountInv(AmmoPool_Action) < takeReserve)
				return;
			
			A_GiveInventory(AmmoMag_Action, giveMag);
			A_TakeInventory(AmmoPool_Action, takeReserve);
		}
	}

	//Copy of Cemtex's PB_AmmoIntoMag but for unloading
	//A way to perform pretty much take all of the "RemoveBullets" states and turn it into a function	
	//An example of this action: PB_UnloadMag("DMRAmmo","PB_HighCalMag",1) 
	// AmmoPool_Action	= The name of the Ammo1 (Reserve) class
	// AmmoMag_Action 	= The name of the Ammo2 (Magazine) class
	// giveReserve 		= How many Ammo1 (Reserve) to give for every cycle
	// takeMag 			= How many Ammo2 (Magazine) to take for every cycle
	// goal 			= If the Ammo2 (Magazine) reaches this number, stop the cycle
	// spawnActor		= What should be spawned if you have full Ammo1 (Reserve) but still Unloads
	action void PB_UnloadMag(class<Inventory> AmmoMag_Action, class<Inventory> AmmoPool_Action, int giveReserve = 1, int takeMag = 1, int maxSize = 0, int goal = 0, class<Inventory> spawnActor = null)
	{
		let pool = FindInventory(AmmoPool_Action);
		int extra = 0;
		
		for(int i = CountInv(AmmoMag_Action); i > goal; i--)
		{
			A_TakeInventory(AmmoMag_Action, takeMag);
			if(CountInv(AmmoPool_Action) < pool.MaxAmount)
				A_GiveInventory(AmmoPool_Action, giveReserve);
			else
				extra += giveReserve;
		}
		
		if(maxsize == 0)
			maxsize = extra;
		
		while(extra > 0)
		{
			let droppedammo = Inventory(Spawn(spawnActor ? spawnActor : AmmoPool_Action,pos));
			if(droppedammo)
			{
				droppedammo.Amount = min(extra, maxSize);
				extra -= maxSize;
				droppedammo.vel.x = frandom(-1,1);
				droppedammo.vel.y = frandom(-1,1);
			}
		}
	}
	
	// Use this instead of A_TakeInventory for taking ammo (unless its a weapon that doesnt have Ammo2 (Magazine))
	// ammoType 	= The name of the Ammo2 (Magazine) class
	// takeNum 		= How many Ammo2 (Magazine) should be taken everytime this function is called
	// emptyMag 	= At what point in Ammo2 (Magazine) should the Magazine be considered Empty
	// dual			= Use to check the left weapon instead
	// emptyChamber = At what point in Ammo2 (Magazine) should the Chamber be considered Empty
	action void PB_TakeAmmo(class<Inventory> ammoType, int takeNum = 1, int emptyMag = 1, int emptyChamber = 0, bool dual = false)
	{
		A_TakeInventory(ammoType, takeNum, TIF_NOTAKEINFINITE);
		if(CountInv(ammoType) <= emptyMag)
			PB_SetMagEmpty(true,dual);
		if(CountInv(ammoType) <= emptyChamber || PB_GetMagUnloaded(dual) && emptyChamber > -1)
			PB_SetChamberEmpty(true,dual);
	}
	
